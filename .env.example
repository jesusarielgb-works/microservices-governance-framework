# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de ambiente para desarrollo local
#
# USO: cp .env.example .env
#      Luego edita .env con tus valores locales.
#
# NUNCA: commitear el archivo .env con valores reales.
#        Los valores reales de dev/staging/prod van en el vault.
# ─────────────────────────────────────────────────────────────────────────────

# ─── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# ─── API Gateway (:8080) ──────────────────────────────────────────────────────
APP_GATEWAY_PORT=8080
APP_GATEWAY_RATE_LIMIT_MAX=100
APP_GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# ─── Auth Service (:8081) ─────────────────────────────────────────────────────
APP_AUTH_PORT=8081
APP_AUTH_DATABASE_URL=postgresql://dev:dev@localhost:5432/auth_db
APP_AUTH_REDIS_URL=redis://localhost:6379
APP_AUTH_BCRYPT_ROUNDS=10

# JWT — RS256: generar con `openssl genrsa -out private.pem 2048`
# En local puedes usar valores de ejemplo. En staging/prod van en el vault.
APP_AUTH_JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n[REEMPLAZAR CON CLAVE PRIVADA]\n-----END RSA PRIVATE KEY-----"
APP_AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n[REEMPLAZAR CON CLAVE PÚBLICA]\n-----END PUBLIC KEY-----"
APP_AUTH_JWT_EXPIRY=3600
APP_AUTH_REFRESH_TOKEN_EXPIRY=604800

# ─── [Nombre Servicio N] (:[puerto]) ─────────────────────────────────────────
# APP_[SERVICIO]_PORT=[puerto]
# APP_[SERVICIO]_DATABASE_URL=postgresql://dev:dev@localhost:5432/[servicio]_db
# APP_[SERVICIO]_[VARIABLE]=[valor de ejemplo local]

# ─── Base de datos compartida (si aplica) ────────────────────────────────────
# Si cada servicio tiene su propia BD, comentar esto y usar las variables por servicio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD= (sin contraseña en local)

# ─── Observabilidad ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=[nombre-proyecto]

# ─── Servicios externos (stubs en local) ─────────────────────────────────────
# Reemplazar con URLs de stubs/mocks para desarrollo local
# APP_[SERVICIO_EXTERNO]_URL=http://localhost:[puerto_del_stub]
# APP_[SERVICIO_EXTERNO]_API_KEY=dev-key-only-local
